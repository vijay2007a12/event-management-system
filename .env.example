# Environment variables for EventHub

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
API_SECRET_KEY=your-secret-key-here

# Payment Integration
NEXT_PUBLIC_STRIPE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Email Service (optional)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@eventhub.com

# Database
DATABASE_URL=mongodb://localhost:27017/eventhub
DATABASE_USER=admin
DATABASE_PASSWORD=password

# Analytics
NEXT_PUBLIC_ANALYTICS_ID=GA-XXXXXXXXX

# Environment
NODE_ENV=development
